# Coleta Inteligente - variáveis de ambiente (exemplo SEM valores reais)
#
# Modo online: o comando `vercel env pull` cria o arquivo .env.local com a
# DATABASE_URL verdadeira do Neon. Para o resto, copie este arquivo para .env
# e preencha. Variáveis definidas no sistema têm prioridade sobre os arquivos.
# Nunca envie .env ou .env.local para o Git nem mostre os valores em prints.

# Banco de dados (obrigatória)
#   Online (Neon):  postgresql://USUARIO:SENHA@HOST.neon.tech/BANCO?sslmode=require
#   Offline:        sqlite:///coleta_local.db   (o gerenciar.py --offline já usa este)
DATABASE_URL=sqlite:///coleta_local.db

# Gestor criado automaticamente quando o banco ainda não tem nenhum (opcional).
# Sem COLETA_ADMIN_SENHA, nenhum gestor é criado: use
#   python gerenciar.py gestor --email SEU_EMAIL
COLETA_ADMIN_EMAIL=admin@coleta.local
COLETA_ADMIN_SENHA=

# Token do ESP32 (opcional). Se definido, o servidor só aceita leituras com o
# cabeçalho X-Token-Dispositivo igual a este valor; informe o mesmo valor no
# portal de configuração do ESP32. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
COLETA_TOKEN_DISPOSITIVO=
